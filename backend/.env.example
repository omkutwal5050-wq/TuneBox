PORT=5000
NODE_ENV=development
MONGO_URI=mongodb://127.0.0.1:27017/tunebox

SPOTIFY_CLIENT_ID=replace-with-your-spotify-client-id
SPOTIFY_CLIENT_SECRET=replace-with-your-spotify-client-secret

gemini_api_key=replace-with-your-gemini-api-key

JWT_SECRET=replace-with-a-random-secret-at-least-32-characters-long
# Backend's public URL; do not append /api.
PUBLIC_API_ORIGIN=http://localhost:5000
# Comma-separated browser origins allowed to call this backend.
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Set this in the Vercel frontend project, not the backend service.
# It must include /api, for example:
# VITE_API_URL=https://tunebox-dd7a.onrender.com/api
VITE_API_URL=http://localhost:5000/api

CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret